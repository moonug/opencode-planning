{
  "name": "opencode-plan-review",
  "version": "0.3.2",
  "description": "opencode plugin: review plans in $EDITOR with per-agent model tracking",
  "type": "module",
  "main": "server.ts",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./server.ts",
    "./tui": "./tui.tsx"
  },
  "files": [
    "index.ts",
    "server.ts",
    "tui.tsx",
    "tui-v2.tsx",
    "v2.ts",
    "tui-plugin.tsx",
    "helpers.ts",
    "install.ts",
    "resolution.ts",
    "system-prompt.ts",
    "commands.ts",
    "model-store.ts",
    "bin/",
    "commands/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:v2": "bun ../tests/v2-plugin-smoke.ts && bun tests/v2-tui-smoke.tsx"
  },
  "keywords": [
    "opencode",
    "plan",
    "review",
    "plugin",
    "agent",
    "model-tracking"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/moonug/opencode-planning"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.6",
    "@opentui/solid": ">=0.5.6",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.21",
    "@opentui/core": "0.5.6",
    "@opentui/solid": "0.5.6",
    "@types/node": "^26.1.1",
    "solid-js": "1.9.12",
    "typescript": "^7.0.2"
  }
}
