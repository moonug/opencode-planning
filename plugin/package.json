{
  "name": "opencode-plan-review",
  "version": "0.3.2",
  "description": "opencode plugin: review plans in $EDITOR with per-agent model tracking",
  "type": "module",
  "main": "index.ts",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./index.ts",
    "./tui": "./tui-plugin.tsx",
    "./v2": "./v2/index.ts"
  },
  "files": [
    "index.ts",
    "tui-plugin.tsx",
    "helpers.ts",
    "install.ts",
    "resolution.ts",
    "system-prompt.ts",
    "commands.ts",
    "model-store.ts",
    "bin/",
    "commands/",
    "v2/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "opencode",
    "plan",
    "review",
    "plugin",
    "agent",
    "model-tracking"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/moonug/opencode-planning"
  },
  "dependencies": {
    "@opentui/solid": "0.4.5",
    "@opencode-ai/plugin": "*",
    "jsonc-parser": "^3.3.1",
    "solid-js": "1.9.12",
    "effect": "^4.0.0-beta.83"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
