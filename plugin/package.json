{
  "name": "opencode-plan-review",
  "version": "0.4.0-alpha.1",
  "description": "opencode2 plugin: review plans in $EDITOR with per-agent model tracking",
  "type": "module",
  "main": "v2/index.ts",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./v2/index.ts",
    "./tui": "./tui.tsx",
    "./v1": "./index.ts",
    "./v1/tui": "./tui-plugin.tsx"
  },
  "files": [
    "v2/",
    "index.ts",
    "tui-plugin.tsx",
    "tui.tsx",
    "tui-v2.tsx",
    "helpers.ts",
    "helper-errors.ts",
    "install.ts",
    "resolution.ts",
    "system-prompt.ts",
    "commands.ts",
    "model-store.ts",
    "bin/",
    "commands/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "typecheck": "bun script/typecheck.ts",
    "test": "bun test ../tests/ && bun tests/v2-tui-smoke.tsx"
  },
  "keywords": [
    "opencode",
    "plan",
    "review",
    "plugin",
    "agent",
    "model-tracking"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/moonug/opencode-planning"
  },
  "dependencies": {
    "effect": "4.0.0-beta.98",
    "jsonc-parser": "^3.3.1"
  },
  "peerDependencies": {
    "@opentui/solid": ">=0.5.6",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode-ai/plugin": "*",
    "@opentui/solid": "0.5.6",
    "@types/node": "^26.1.1",
    "solid-js": "1.9.12",
    "typescript": "^7.0.2"
  }
}
